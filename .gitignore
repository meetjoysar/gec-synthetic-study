# ---- data and models (never committed) ----
data/
models/
*.tar.gz
*.zip

# ---- results: keep tables/figures/markdown, drop weights and bulky predictions ----
results/runs/*/*/model/
results/runs/*/*/checkpoint*/
results/runs/*/*/predictions/*.txt
results/runs/*/*/predictions/*.m2
results/runs/_timing.jsonl
results/e4_matching/
# smoke and timing-probe runs are throwaway; they must never reach a report
# table (aggregate skips them by prefix) and have no business in git either.
results/runs/smoke_*/
results/runs/probe_*/
!results/runs/*/*/metrics.json
!results/runs/*/*/config.yaml
!results/runs/*/*/env.json
!results/runs/*/*/train_metrics.json
!results/runs/*/*/predict_meta.json
!results/runs/*/*/predictions/*.csv

# ---- environments ----
.venv/
.venv-gec/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- caches ----
.hf_cache/
.cache/
*.spacy

# ---- course PDFs: kept on disk, not in git (third-party copyright; cited in CREDITS.md) ----
*.pdf

# ---- raw collected sentences and in-progress annotation (never committed) ----
# The sentences themselves are third-party text copied from public posts; only
# the curated TSV (no usernames, no links) is tracked.
data_manual/manual_sentences.txt
data_manual/candidates.tsv
data_manual/annotation/

# ---- scratch ----
.extract/
scratch/
*.log
~$*
Thumbs.db
desktop.ini

# ---- local-only docs (machine-specific paths / group's own Activity 1 report) ----
# HOW_TO_RUN.md hardcodes this machine's interpreter path, so it is kept on disk
# rather than committed. IA1_REPORT_GEC.md is the group's Activity 1 submission,
# carried here for reference only.
HOW_TO_RUN.md
IA1_REPORT_GEC.md

# ---- gradio runtime cache ----
.gradio/
